# Copia este archivo a .env.local y completa los valores reales.
# Nunca subas .env.local a git ni coloques estas keys en código de cliente.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (almacenamiento real de leads — ver lib/supabase/schema.ts) ---
# Sin estas variables, los leads se guardan solo en memoria (se pierden en
# cada reinicio y NO funcionan en producción serverless). Ver README.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Proveedor de IA para el Asistente (aún no conectado, usa mock) ---
# Elegir uno: OpenAI o Azure OpenAI.
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# --- Notificación por correo de nuevos leads (lib/email/notify-lead.ts) ---
# Sin RESEND_API_KEY, el envío se omite silenciosamente (no rompe el sitio).
RESEND_API_KEY=
NOTIFICATIONS_EMAIL_TO=ravelaservicios@gmail.com

# --- CRM (futuro) ---
CRM_WEBHOOK_URL=

# --- Analytics (Fase 12) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
