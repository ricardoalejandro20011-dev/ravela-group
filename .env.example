# Nunca subas .env.local ni claves privadas al repositorio.
# Configura los mismos valores en Vercel > Project > Settings > Environment Variables.

# Persistencia obligatoria para recibir prospectos en producción.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notificación opcional: el prospecto se guarda antes de enviar el aviso.
RESEND_API_KEY=
NOTIFICATIONS_EMAIL_TO=hola@ravela.online
# Usa un remitente verificado. Si se omite se conserva onboarding@resend.dev.
RESEND_FROM=

# El contacto público confirmado se configura en lib/constants/contacto.ts.
